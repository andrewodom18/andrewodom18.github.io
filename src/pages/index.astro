---
import ContactBand from "../components/ContactBand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { resumeContent } from "../data/resume";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <SiteHeader currentPath="/" />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell">
        <div class="hero__grid">
          <div class="hero__heading">
            <p class="eyebrow hero__eyebrow">{resumeContent.hero.eyebrow}</p>
            <h1 id="hero-title">{resumeContent.hero.title}</h1>
          </div>
          <div class="hero__side" data-reveal>
            <div class="hero__intro">
              <p>{resumeContent.hero.summary}</p>
            </div>
            <div class="button-row hero__actions">
              <a
                class="button button--primary"
                href={resumeContent.site.resumePdf}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open resume (PDF)
              </a>
              <a
                class="text-link"
                href="https://github.com/odom-technology"
                target="_blank"
                rel="noopener noreferrer"
              >
                ODOM Tech portfolio <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>

        <dl class="hero-profile" data-reveal aria-label="Professional profile">
          {
            resumeContent.hero.profile.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="shell about__grid">
        <div data-reveal>
          <p class="eyebrow">{resumeContent.about.eyebrow}</p>
          <h2 id="about-title">{resumeContent.about.title}</h2>
          <p class="about__status"><span aria-hidden="true"></span>{resumeContent.about.status}</p>
        </div>
        <div class="about__copy" data-reveal>
          {resumeContent.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="section experience" id="experience" aria-labelledby="experience-title">
      <div class="shell experience__grid">
        <div data-reveal>
          <p class="eyebrow">{resumeContent.experience.eyebrow}</p>
          <h2 id="experience-title">{resumeContent.experience.title}</h2>
        </div>

        <article class="experience-card" data-reveal>
          <div class="experience-card__heading">
            <div>
              <p>{resumeContent.experience.role}</p>
              <h3>{resumeContent.experience.organization}</h3>
            </div>
            <span>{resumeContent.experience.dates}</span>
          </div>
          <p class="experience-card__summary">{resumeContent.experience.summary}</p>
          <ul>
            {resumeContent.experience.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <section class="section education" id="education" aria-labelledby="education-title">
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow">Education</p>
            <h2 id="education-title">Education and continued learning.</h2>
          </div>
        </div>
        <div class="education-grid">
          {
            resumeContent.education.map((item) => (
              <article class="education-card" data-reveal>
                <span>{item.status}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section expertise" id="skills" aria-labelledby="skills-title">
      <div class="shell">
        <div class="section-heading section-heading--stacked" data-reveal>
          <p class="eyebrow">Skills</p>
          <h2 id="skills-title">Core technical skills.</h2>
        </div>

        <div class="expertise-list">
          {
            resumeContent.skills.map((area) => (
              <article data-reveal>
                <span class="expertise-list__number">{area.number}</span>
                <h3>{area.title}</h3>
                <ul aria-label={`${area.title} technologies`}>
                  {area.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section ownership" id="portfolio" aria-labelledby="ownership-title">
      <div class="shell ownership__grid">
        <div data-reveal>
          <p class="eyebrow">{resumeContent.ownership.eyebrow}</p>
          <h2 id="ownership-title">{resumeContent.ownership.title}</h2>
        </div>
        <div class="ownership__copy" data-reveal>
          <p>{resumeContent.ownership.text}</p>
          <a
            class="button button--light"
            href={resumeContent.ownership.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            View the ODOM Tech portfolio <span aria-hidden="true">↗</span>
          </a>
          <article class="ownership-project">
            <p class="eyebrow">Selected project · Live web app</p>
            <h3>PocketLedger</h3>
            <p>I designed and built this private finance PWA, from exact money calculations and recoverable local storage to offline deployment.</p>
            <div class="button-row"><a class="text-link" href="/work/pocketledger/">My role and contributions <span aria-hidden="true">→</span></a><a class="text-link" href="https://pocketledger-eyp.pages.dev/">Open PocketLedger <span aria-hidden="true">↗</span></a></div>
          </article>
        </div>
      </div>
    </section>

    <ContactBand />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .ownership-project { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--line-strong); }
  .ownership-project .eyebrow { font-size: .74rem; margin-bottom: .8rem; }
  .ownership-project h3 { font-family: var(--display); font-size: 2rem; margin-bottom: .8rem; }
  .ownership-project p:not(.eyebrow) { font-size: 1rem; line-height: 1.7; margin-bottom: 1rem; }
</style>
