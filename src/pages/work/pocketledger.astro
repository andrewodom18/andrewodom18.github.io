---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ContactBand from "../../components/ContactBand.astro";
---

<BaseLayout
  title="PocketLedger: my role and contributions | Andrew Odom"
  description="My role building PocketLedger, an offline finance app: product design, exact calculations, local storage, recovery, and static deployment."
  canonicalPath="/work/pocketledger/"
>
  <SiteHeader currentPath="/work/pocketledger/" />
  <main id="main" class="project-page">
    <header class="project-intro shell">
      <p class="eyebrow">Independent product engineering · ODOM Tech</p>
      <h1>PocketLedger</h1>
      <p class="project-lead">My role: design and build a private finance app from product decisions through deployment.</p>
      <p class="project-summary">I created PocketLedger under ODOM Tech, bringing budgeting, shared expenses, and debt payoff planning into an offline-capable web app. I chose a static deployment and device-local storage to keep it useful without account setup or a paid backend.</p>
      <div class="button-row"><a class="button button--primary" href="https://pocketledger-eyp.pages.dev/">Open PocketLedger</a><a class="text-link" href="https://odomtech.com/pocketledger/">Read the full case study at ODOM Tech <span aria-hidden="true">↗</span></a></div>
    </header>
    <section class="section shell project-contributions" aria-labelledby="contributions-title">
      <div><p class="eyebrow">My contributions</p><h2 id="contributions-title">Product, engineering, and delivery.</h2></div>
      <ul>
        <li><strong>Product and interface:</strong> designed responsive budgeting, group settlement, and debt comparison workflows, with an isolated demo and clear boundaries between each tool’s records.</li>
        <li><strong>Calculations and recovery:</strong> implemented exact money allocation, debt projections, revision-safe IndexedDB saves, and validated imports with portable encrypted backups.</li>
        <li><strong>Verification and deployment:</strong> built calculation and recovery tests, checked offline and browser behavior, and deployed the React/TypeScript PWA to Cloudflare Pages.</li>
      </ul>
    </section>
    <figure class="shell project-preview"><picture><source media="(max-width: 760px)" srcset="/assets/projects/pocketledger-overview-mobile.png" width="390" height="844" /><img src="/assets/projects/pocketledger-overview-desktop.png" width="1440" height="1000" alt="PocketLedger sample workspace with budget, shared expense, and debt payoff summaries." /></picture><figcaption>The app using synthetic demo data. The full product walkthrough, engineering decisions, and validation limits live in the <a class="text-link" href="https://odomtech.com/pocketledger/">shared ODOM Tech case study</a>.</figcaption></figure>
    <div class="shell project-back"><a class="text-link" href="/#portfolio">Back to my profile <span aria-hidden="true">→</span></a></div>
    <ContactBand />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .project-intro { padding-block: clamp(5rem, 9vw, 8rem) 1rem; }
  .project-intro h1 { font-family: var(--display); font-size: clamp(3.2rem, 8vw, 7rem); font-weight: 500; line-height: 1; letter-spacing: -.05em; margin-block: 1rem 1.75rem; overflow-wrap: anywhere; }
  .project-lead { max-width: 40ch; font-size: clamp(1.4rem, 2.7vw, 2rem); line-height: 1.4; color: var(--ink-soft); }
  .project-summary { max-width: 68ch; color: var(--muted); margin-block: 1.5rem 2rem; }
  .project-contributions { display: grid; grid-template-columns: .82fr 1.18fr; gap: clamp(2rem, 5vw, 5rem); }
  .project-contributions h2 { font-family: var(--display); font-size: clamp(2rem, 4.2vw, 3.5rem); font-weight: 500; line-height: 1.08; letter-spacing: -.035em; max-width: 23ch; }
  .project-contributions ul { margin: 0; padding-left: 1.3rem; color: var(--ink-soft); }
  .project-contributions li { padding-left: .3rem; margin-bottom: 1.5rem; }
  .project-preview { margin-block: 0; }
  .project-preview img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .project-preview figcaption { margin-top: .8rem; font-size: .88rem; color: var(--muted); }
  .project-back { padding-top: 2rem; }
  @media (max-width: 760px) { .project-contributions { grid-template-columns: 1fr; } }
</style>
