---
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { resumeContent } from "../../data/resume";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Resume | ${resumeContent.site.name}`}
  description="Web and print resume for Andrew Odom, a software developer and creator of ODOM Tech."
  canonicalPath="/resume/"
>
  <div class="resume-site-header">
    <SiteHeader currentPath="/resume/" />
  </div>

  <main id="main" class="resume-page">
    <div class="resume-actions" aria-label="Resume actions">
      <div class="resume-actions__primary">
        <a
          class="button button--primary"
          href={resumeContent.site.resumePdf}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open PDF
        </a>
        <a
          class="text-link"
          href={resumeContent.site.resumePdf}
          download="Andrew-Odom-Resume.pdf"
        >
          Download PDF <span aria-hidden="true">↓</span>
        </a>
      </div>
      <a
        class="text-link"
        href={resumeContent.ownership.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        View ODOM Tech portfolio <span aria-hidden="true">↗</span>
      </a>
    </div>

    <article class="resume-document">
      <header class="resume-header">
        <div>
          <p class="eyebrow">Software Developer</p>
          <h1>{resumeContent.site.name}</h1>
          <p class="resume-header__summary">
            Software developer at Air Force BESPIN with experience across web, mobile,
            data, testing, and delivery automation. Creator of ODOM Tech.
          </p>
        </div>
        <address>
          <a href={`mailto:${resumeContent.site.email}`}>{resumeContent.site.email}</a>
          <a href={resumeContent.site.url}>andrewodom18.github.io</a>
          <a href="https://linkedin.com/in/andrewodom18/">linkedin.com/in/andrewodom18</a>
        </address>
      </header>

      <section class="resume-section" aria-labelledby="resume-experience-title">
        <h2 id="resume-experience-title">Experience</h2>
        <article class="resume-role">
          <div class="resume-role__heading">
            <div>
              <h3>{resumeContent.experience.role}</h3>
              <p>{resumeContent.experience.organization}</p>
            </div>
            <span>{resumeContent.experience.dates}</span>
          </div>
          <p>{resumeContent.experience.summary}</p>
          <ul>
            {resumeContent.experience.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      </section>

      <section class="resume-section" aria-labelledby="resume-leadership-title">
        <h2 id="resume-leadership-title">Leadership</h2>
        <article class="resume-role">
          <div class="resume-role__heading">
            <div>
              <h3>{resumeContent.ownership.title}</h3>
              <p>ODOM Tech</p>
            </div>
          </div>
          <p>{resumeContent.ownership.text}</p>
        </article>
      </section>

      <section class="resume-section" aria-labelledby="resume-skills-title">
        <h2 id="resume-skills-title">Technical skills</h2>
        <div class="resume-skills">
          {
            resumeContent.skills.map((area) => (
              <article>
                <h3>{area.title}</h3>
                <p>{area.tools.join(", ")}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-section" aria-labelledby="resume-education-title">
        <h2 id="resume-education-title">Education</h2>
        <div class="resume-education">
          {
            resumeContent.education.map((item) => (
              <article>
                <span>{item.status}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </section>
    </article>
  </main>

  <div class="resume-site-footer">
    <SiteFooter />
  </div>
</BaseLayout>
