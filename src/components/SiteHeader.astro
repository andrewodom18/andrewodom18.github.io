---
import { resumeContent } from "../data/resume";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const normalizePath = (value: string) => (value.endsWith("/") ? value : `${value}/`);
const isCurrent = (href: string) => {
  if (href.includes("#")) return false;
  if (href === "/work/") return normalizePath(currentPath).startsWith("/work/");
  return normalizePath(currentPath) === normalizePath(href);
};
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="/">
      <span class="brand__text">
        <strong>{resumeContent.site.name}</strong>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {
        resumeContent.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

  </div>
</header>
