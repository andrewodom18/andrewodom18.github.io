---
import { resumeContent } from "../data/resume";

const emailHref = `mailto:${resumeContent.site.email}?subject=${encodeURIComponent(
  resumeContent.contact.emailSubject
)}`;
---

<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <div class="contact-band__inner" data-reveal>
    <div class="contact-band__grid">
      <div class="contact-band__intro">
        <p class="eyebrow eyebrow--light">{resumeContent.contact.eyebrow}</p>
        <h2 id="contact-title">{resumeContent.contact.title}</h2>
        <p>{resumeContent.contact.text}</p>
        <p>{resumeContent.contact.projectText}</p>
      </div>
      <div class="contact-band__panel" aria-label="Contact options">
        <ul class="contact-band__profiles" aria-label="Contact links">
          <li class="contact-band__secondary">
            <span>Email</span>
            <a href={emailHref}>
              {resumeContent.site.email}
            </a>
          </li>
          <li class="contact-band__secondary">
            <span>ODOM Tech</span>
            <a
              href={resumeContent.contact.projectHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              Use the contact form
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
