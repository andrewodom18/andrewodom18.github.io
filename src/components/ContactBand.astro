---
import { portfolioContent } from "../data/portfolio";

const emailHref = `mailto:${portfolioContent.site.email}?subject=${encodeURIComponent(
  portfolioContent.contact.emailSubject
)}`;
---

<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <div class="contact-band__inner" data-reveal>
    <div class="contact-band__grid">
      <div class="contact-band__intro">
        <p class="eyebrow eyebrow--light">{portfolioContent.contact.eyebrow}</p>
        <h2 id="contact-title">{portfolioContent.contact.title}</h2>
        <p>{portfolioContent.contact.text}</p>
      </div>
      <div class="contact-band__panel" aria-label="Contact options">
        <p class="contact-band__label">Email</p>
        <a class="contact-band__email" href={emailHref} data-email-address>
          {portfolioContent.site.email}
        </a>
        <p class="contact-band__note">{portfolioContent.contact.emailNote}</p>
        <div class="contact-band__actions">
          <button
            class="button button--light"
            type="button"
            data-copy-email
            data-email={portfolioContent.site.email}
          >
            Copy email address
          </button>
          <a class="button button--contact-outline" href={emailHref}>
            Open email app <span aria-hidden="true">↗</span>
          </a>
        </div>
        <span class="contact-band__status" role="status" aria-live="polite" data-copy-status></span>
        <div class="contact-band__secondary">
          <span>LinkedIn</span>
          <a
            href="https://linkedin.com/in/andrewodom18/"
            target="_blank"
            rel="noopener noreferrer"
          >
            View professional profile <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
