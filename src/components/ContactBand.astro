---
import { portfolioContent } from "../data/portfolio";

const emailHref = `mailto:${portfolioContent.site.email}?subject=${encodeURIComponent(
  portfolioContent.contact.emailSubject
)}`;
---

<section class="contact-band" id="contact" aria-labelledby="contact-title">
  <div class="contact-band__inner" data-reveal>
    <div class="contact-band__grid">
      <div class="contact-band__intro">
        <p class="eyebrow eyebrow--light">{portfolioContent.contact.eyebrow}</p>
        <h2 id="contact-title">{portfolioContent.contact.title}</h2>
        <p>{portfolioContent.contact.text}</p>
      </div>
      <div class="contact-band__panel" aria-label="Contact options">
        <ul class="contact-band__profiles" aria-label="Contact links">
          <li class="contact-band__secondary">
            <span>Email</span>
            <a href={emailHref}>
              {portfolioContent.site.email} <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li class="contact-band__secondary">
            <span>LinkedIn</span>
            <a
              href="https://www.linkedin.com/in/andrewodom18"
              target="_blank"
              rel="noopener noreferrer"
            >
              https://www.linkedin.com/in/andrewodom18 <span aria-hidden="true">↗</span>
            </a>
          </li>
          <li class="contact-band__secondary">
            <span>GitHub</span>
            <a
              href="https://github.com/andrewodom18"
              target="_blank"
              rel="noopener noreferrer"
            >
              https://github.com/andrewodom18 <span aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
