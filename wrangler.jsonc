{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aodom-dev",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "aodom.dev",
      "custom_domain": true
    }
  ]
}
